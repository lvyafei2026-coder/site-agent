# 站群绑定（换站群只改这里 + SITES 清单 + 各项凭据）
FLEET_DOMAIN=            # 站群主域，如 toolara.dev；子站 host / radar 地址 / GSC 资源都从这里派生

# Cloudflare
CF_ACCOUNT_ID=
CF_API_TOKEN=            # 权限：D1 Edit + Workers KV Storage Edit
D1_DATABASE_ID=          # 入口代理（gateway）的 CLICKS 库 ID
KV_NAMESPACE_ID=         # 用于 agent:pause:* / agent:approval:*

# GitHub（细粒度 PAT：仅子站仓库，Contents: Read and write）
GITHUB_TOKEN=
GH_ORG=                  # 如 your-github-org

# Google Search Console（服务账号，加为该资源所有者）
GSC_SA_JSON=             # 单行 JSON
GSC_PROPERTY=            # 留空 = sc-domain:<FLEET_DOMAIN>

# LLM（OpenAI 兼容端点）
LLM_API_KEY=
LLM_BASE_URL=            # 留空走官方；兼容端点填 https://xxx/v1

# radar（读候选词；私有仓库有 Basic Auth；留空 = https://radar.<FLEET_DOMAIN>）
RADAR_URL=
RADAR_USER=
RADAR_PASS=

# 通知与审批（IMAP 轮询收确认回复，无需公网入口）
RESEND_API_KEY=
CONTACT_EMAIL=           # 运营者联系方式：发件人、外链采集 UA 的 contact；也是商用授权邮箱
MAIL_FROM=               # 留空 = site-agent <CONTACT_EMAIL>
ADMIN_EMAIL=
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=                # 应用专用密码，不是登录密码

# 外链渠道（可选，缺失时 Dev.to 降级为草稿，不影响其他任务）
DEVTO_API_KEY=

# 业务上限（可选，括号内为默认值）
MAX_PAGES_PER_RUN=5       # 单次内容生成上限
MAX_LLM_CALLS_PER_DAY=100 # 每日 LLM 调用上限，超限写 KV 暂停
BREAKER_THRESHOLD=3       # 连续失败几次触发熔断
BREAKER_COOLDOWN_SEC=1800 # 熔断冷却秒数

# 本地状态（Render 上挂盘到 /data）
AGENT_STATE_DIR=./data
TZ=Asia/Shanghai
