# 进程
LOG_LEVEL=INFO
PORT=10000

# 运行时：checkpointer 与 LangSmith
MEMORY_BACKEND=memory
# 生产：MEMORY_BACKEND=sqlite + DATABASE_URL=sqlite:////data/agent.sqlite
DATABASE_URL=
# LangSmith 追踪（可选）：TRACING=true 且 API_KEY 非空才真正上报
#   开启后 smith.langchain.com 的项目里能看到：图级 run → 节点 → LLM 请求三层
#   ENDPOINT 只有欧盟区实例才需要改成 https://eu.api.smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=site-agent
# 项目页地址（可选，不是凭据）：从浏览器地址栏复制，填了 console 结果卡上会出现直达链接
LANGSMITH_PROJECT_URL=
MAX_VALIDATION_RETRIES=2

# LLM（留空则意图分类/字段抽取走确定性本地回退；热词分析会跳过，不编造正文）
# GitHub Models 接法（免费、OpenAI 兼容）：
#   LLM_BASE_URL=https://models.github.ai/inference
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_API_KEY=ghp_xxx 或 github_pat_xxx（GitHub PAT，需 models:read 权限）；
#   权限不足/过期/错填成 OpenAI key 时，GitHub Models 会回 200+"OK" 桩而非 401，
#   表现为抽取静默失败——见 llm_service 的 llm_stub_response 告警。
# 排查「返回 OK 桩 / 非 JSON」时，临时设 LLM_DEBUG=1：会在日志里打印真正的 HTTP 请求
# URL、状态码、响应头与响应体（llm_http_request / llm_http_response），以及每条解析
# 阶段的中间结果（llm_request / llm_raw_response / llm_content_extracted /
# llm_after_strip_fences / llm_parse_result），可一次性定位问题，排查完建议关掉。
LLM_DEBUG=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# 站群唯一主域
FLEET_DOMAIN=toolara.dev
CONTACT_EMAIL=
AGENT_STATE_DIR=

# Cloudflare（★热词分析必须：agent 经 Cloudflare KV REST API 直读直写与 radar/console
# 共用的 RADAR_KV 命名空间，这是「存储介质依赖」不是「服务接口依赖」；CF_ACCOUNT_ID /
# CF_API_TOKEN / KV_NAMESPACE_ID 三者必须齐全且与 Cloudflare 侧 RADAR_KV 一致）
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=
KV_NAMESPACE_ID=

# GitHub / 建站
GITHUB_TOKEN=
GH_ORG=

# 数据源与发布（可选）
GSC_SA_JSON=
GSC_PROPERTY=
RESEND_API_KEY=
ADMIN_EMAIL=
DEVTO_API_KEY=

# SERP 出口（可选）：只在部署环境连不上 DuckDuckGo 时填。
# 专用于 SERP 抓取，不影响同一进程里的 KV REST / LLM / GitHub 调用；留空走直连。
# 例：http://user:pass@proxy.example.com:8080
# 背景：Render singapore 出口实测 4 发全部 ConnectTimeout，而本机直连/代理、另一云端
#       出口都能拿到 200 + 10 条真结果，属出口网络问题，不是 DDG 封所有爬虫。
SERP_HTTPS_PROXY=

# 直连 4 发全挂时的自动兜底：公共 Reader 云端中转取回**原始 DDG HTML**（免 key、无需注册），
# 解析/打分口径与直连完全一致。1=开启（默认）／0=完全关闭，不向第三方发任何请求。
SERP_FALLBACK_READER=1
