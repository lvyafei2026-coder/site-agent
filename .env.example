# 进程
LOG_LEVEL=INFO
PORT=10000

# 运行时：checkpointer 与 LangSmith
MEMORY_BACKEND=memory
# 生产：MEMORY_BACKEND=sqlite + DATABASE_URL=sqlite:////data/agent.sqlite
DATABASE_URL=
# LangSmith 追踪（可选）：TRACING=true 且 API_KEY 非空才真正上报
#   开启后 smith.langchain.com 的项目里能看到：图级 run → 节点 → LLM 请求三层
#   ENDPOINT 只有欧盟区实例才需要改成 https://eu.api.smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=site-agent
MAX_VALIDATION_RETRIES=2

# LLM（留空则走确定性本地回退，图仍可跑）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# 站群唯一主域
FLEET_DOMAIN=toolara.dev
RADAR_URL=
CONTACT_EMAIL=
AGENT_STATE_DIR=

# Cloudflare
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=
KV_NAMESPACE_ID=

# GitHub / 建站
GITHUB_TOKEN=
GH_ORG=

# 数据源与发布（可选）
RADAR_USER=
RADAR_PASS=
GSC_SA_JSON=
GSC_PROPERTY=
RESEND_API_KEY=
ADMIN_EMAIL=
DEVTO_API_KEY=
