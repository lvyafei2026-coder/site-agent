# 进程
LOG_LEVEL=INFO
PORT=10000

# 运行时：checkpointer 与 LangSmith
MEMORY_BACKEND=memory
# 生产：MEMORY_BACKEND=sqlite + DATABASE_URL=sqlite:////data/agent.sqlite
DATABASE_URL=
# LangSmith 追踪（可选）：TRACING=true 且 API_KEY 非空才真正上报
#   开启后 smith.langchain.com 的项目里能看到：图级 run → 节点 → 热词批次 → 逐词 → LLM
#   热词批次是一条树（并发 worker 显式传 parent），不是 20 条散落的 ChatOpenAI 根 run
#   ENDPOINT 只有欧盟区实例才需要改成 https://eu.api.smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=site-agent
# 项目页地址（可选，不是凭据）：从浏览器地址栏复制；填了 console 结果卡有直达链接，
# 热词分析返回的 traceRun.url 也会带本批次根 run 的直达地址（不发额外网络请求）
LANGSMITH_PROJECT_URL=
MAX_VALIDATION_RETRIES=2

# LLM（留空则意图分类/字段抽取走确定性本地回退；热词分析会跳过，不编造正文）
# DeepSeek 官方（标准 OpenAI 兼容，只需这三个变量，无需改代码）：
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-flash
#   LLM_API_KEY=<platform.deepseek.com 申请的 key，需有余额>
# 注意：老模型名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役，勿填。
# ★DeepSeek 思考模式默认开启（reasoning_content 会先吃光逐词分析的 max_tokens，
#   导致 finish_reason=length、正文为空）。LLM_THINKING 控制逐词分析是否关闭它：
#   auto（默认，仅 DeepSeek 自动关）/ off（强制关）/ on（保留思考，需调大 MAX_TOKENS）。
# 排查 LLM 时临时设 LLM_DEBUG=1：日志会打印真实 HTTP 请求 URL、状态码、响应头与
# 响应体（llm_http_request / llm_http_response），以及各解析阶段中间结果
# （llm_request / llm_raw_response / llm_content_extracted / llm_after_strip_fences /
# llm_parse_result）。排查完把该变量去掉即可。
LLM_DEBUG=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-flash
LLM_THINKING=auto

# 站群唯一主域
FLEET_DOMAIN=toolara.dev
CONTACT_EMAIL=
AGENT_STATE_DIR=

# Cloudflare（★热词分析必须：agent 经 Cloudflare KV REST API 直读直写与 radar/console
# 共用的 RADAR_KV 命名空间，这是「存储介质依赖」不是「服务接口依赖」；CF_ACCOUNT_ID /
# CF_API_TOKEN / KV_NAMESPACE_ID 三者必须齐全且与 Cloudflare 侧 RADAR_KV 一致）
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=
KV_NAMESPACE_ID=
# 状态回填入口 POST /backfill 的令牌（请求头 X-Backfill-Token）。
# 默认 dry_run=true 只出报告；要真正补写状态需显式传 dry_run=false，此时强烈建议配好令牌。
BACKFILL_TOKEN=

# GitHub / 建站
GITHUB_TOKEN=
GH_ORG=

# 数据源与发布（可选）
GSC_SA_JSON=
GSC_PROPERTY=
RESEND_API_KEY=
ADMIN_EMAIL=
DEVTO_API_KEY=

# SERP 出口（可选）：只在部署环境连不上 DuckDuckGo 时填。
# 专用于 SERP 抓取，不影响同一进程里的 KV REST / LLM / GitHub 调用；留空走直连。
# 例：http://user:pass@proxy.example.com:8080
# 背景：Render singapore 出口实测 4 发全部 ConnectTimeout，而本机直连/代理、另一云端
#       出口都能拿到 200 + 10 条真结果，属出口网络问题，不是 DDG 封所有爬虫。
SERP_HTTPS_PROXY=

# 直连 4 发全挂时的自动兜底：公共 Reader 云端中转取回**原始 DDG HTML**（免 key、无需注册），
# 解析/打分口径与直连完全一致。1=开启（默认）／0=完全关闭，不向第三方发任何请求。
SERP_FALLBACK_READER=1
